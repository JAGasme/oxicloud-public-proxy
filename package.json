{
  "name": "oxicloud-public-proxy",
  "version": "2.0.0",
  "description": "Public reverse proxy for OxiCloud share links - exposes shares on a public domain while keeping OxiCloud private.",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node --env-file=.env dist/server.js",
    "dev": "tsx watch --env-file=.env src/server.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/formbody": "^9.0.1",
    "@fastify/static": "^10.1.9",
    "@fastify/view": "^12.0.1",
    "ejs": "^7.0.2",
    "fastify": "^5.12.8"
  },
  "devDependencies": {
    "@types/ejs": "^3.1.5",
    "@types/node": "^24.19.2",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2"
  }
}
