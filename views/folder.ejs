<%
  function formatSize(bytes) {
    if (bytes == null || isNaN(bytes)) return '';
    if (bytes < 1024) return bytes + ' B';
    const units = ['KB', 'MB', 'GB', 'TB'];
    let value = bytes / 1024;
    let i = 0;
    while (value >= 1024 && i < units.length - 1) { value /= 1024; i++; }
    return (value < 10 ? value.toFixed(1) : Math.round(value)) + ' ' + units[i];
  }
  function fileIcon(mime, name) {
    const m = (mime || '').toLowerCase();
    const match = (name || '').toLowerCase().match(/\.([a-z0-9]+)$/);
    const ext = match ? match[1] : '';

    switch (ext) {
      case 'pdf': return 'pdf.png';
      case 'doc': case 'docx': case 'odt': case 'rtf': case 'pages':
        return 'word.png';
      case 'xls': case 'xlsx': case 'ods': case 'csv': case 'numbers':
        return 'excel.png';
      case 'ppt': case 'pptx': case 'odp': case 'key':
        return 'powerpoint.png';
      case 'txt': case 'md': case 'markdown': case 'log': case 'readme':
        return 'txt.png';
      case 'epub': case 'mobi': case 'azw': case 'azw3':
        return 'ebook.png';
      case 'zip': case 'tar': case 'gz': case 'tgz': case '7z': case 'rar':
      case 'bz2': case 'xz': case 'zst': case 'lz4':
        return 'archive.png';
      case 'iso': case 'img': case 'dmg': case 'vhd': case 'vmdk':
        return 'diskimage.png';
      case 'exe': case 'msi': case 'app': case 'deb': case 'rpm': case 'apk':
      case 'appimage': case 'flatpak': case 'snap':
        return 'exe.png';
      case 'js': case 'mjs': case 'cjs': case 'ts': case 'jsx': case 'tsx':
        return 'javascript.png';
      case 'py': case 'pyi': case 'pyw':
        return 'python.png';
      case 'c': case 'cpp': case 'cc': case 'cxx': case 'h': case 'hpp':
      case 'hxx':
        return 'cpp.png';
      case 'html': case 'htm': case 'xhtml':
        return 'html-file.png';
      case 'ino': case 'pde':
        return 'ino.png';
    }

    if (m === 'application/pdf') return 'pdf.png';
    if (m === 'application/zip' || m.includes('compressed') || m.includes('archive'))
      return 'archive.png';
    if (m.includes('msdownload') || m.includes('executable') || m.includes('installer'))
      return 'exe.png';
    if (m.includes('opendocument.text') || m.includes('msword') || m.includes('wordprocessing'))
      return 'word.png';
    if (m.includes('spreadsheet') || m.includes('excel'))
      return 'excel.png';
    if (m.includes('presentation') || m.includes('powerpoint'))
      return 'powerpoint.png';
    if (m === 'text/html') return 'html-file.png';
    if (m.startsWith('text/')) return 'txt.png';

    return 'placeholder.png';
  }
  function mediaKind(mime) {
    const m = (mime || '').toLowerCase();
    if (m.startsWith('image/')) return 'image';
    if (m.startsWith('video/')) return 'video';
    return null;
  }
  const isSubfolder = folderId != null;
  const empty = folders.length === 0 && files.length === 0;
  const tokenEnc = encodeURIComponent(token);
  const fileUrl = function(id) {
    return '/share/' + tokenEnc + '/file/' + encodeURIComponent(id);
  };
%>
<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <meta name="robots" content="noindex,nofollow" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700&display=swap"
    rel="stylesheet"
  />
  <link rel="stylesheet" href="/public/css/folder.css?v=<%= assetVersion %>" />
</head>
<body>
  <main>
    <div class="topbar">
      <h1><%= title %></h1>
      <div class="actions">
        <% if (isSubfolder) { %>
          <a class="pill" href="/share/<%= tokenEnc %>">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="19" y1="12" x2="5" y2="12" />
              <polyline points="12 19 5 12 12 5" />
            </svg>
            <span><%= t('folder.back_to_root') %></span>
          </a>
        <% } %>
        <div class="view-toggle" role="group" aria-label="View">
          <button type="button" data-view="grid" aria-pressed="true" aria-label="Grid">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="3" width="7" height="7" />
              <rect x="14" y="3" width="7" height="7" />
              <rect x="3" y="14" width="7" height="7" />
              <rect x="14" y="14" width="7" height="7" />
            </svg>
          </button>
          <button type="button" data-view="list" aria-pressed="false" aria-label="List">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="8" y1="6" x2="21" y2="6" />
              <line x1="8" y1="12" x2="21" y2="12" />
              <line x1="8" y1="18" x2="21" y2="18" />
              <line x1="3" y1="6" x2="3.01" y2="6" />
              <line x1="3" y1="12" x2="3.01" y2="12" />
              <line x1="3" y1="18" x2="3.01" y2="18" />
            </svg>
          </button>
        </div>
        <a class="zip-btn"
           href="/share/<%= tokenEnc %><%= isSubfolder ? '/zip/' + encodeURIComponent(folderId) : '/zip' %>"
           download>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
            <polyline points="7 10 12 15 17 10" />
            <line x1="12" y1="15" x2="12" y2="3" />
          </svg>
          <span><%= t('folder.zip_button') %></span>
        </a>
      </div>
    </div>

    <% if (empty) { %>
      <div class="empty">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
          <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z" />
        </svg>
        <span><%= t('folder.empty') %></span>
      </div>
    <% } %>

    <% if (folders.length > 0) { %>
      <h2 class="section-title">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z" />
        </svg>
        <span><%= t('folder.section.folders') %></span>
      </h2>
      <div class="folders-grid">
        <% folders.forEach(function(f) { %>
          <a class="folder-card" href="/share/<%= tokenEnc %>/folder/<%= encodeURIComponent(f.id) %>">
            <span class="icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z" />
              </svg>
            </span>
            <div class="card-body">
              <div class="card-name"><%= f.name %></div>
              <div class="card-meta"><%= t('folder.subfolder_label') %></div>
            </div>
          </a>
        <% }) %>
      </div>
    <% } %>

    <% if (files.length > 0) { %>
      <h2 class="section-title">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
          <polyline points="14 2 14 8 20 8" />
        </svg>
        <span><%= t('folder.section.files') %></span>
      </h2>
      <div class="grid" id="files-grid">
        <% files.forEach(function(f) {
             const kind = mediaKind(f.mime_type);
             const url = fileUrl(f.id);
        %>
          <a class="card-link"
             href="<%= url %>"
             data-id="<%= f.id %>"
             data-name="<%= f.name %>"
             data-mime="<%= f.mime_type || '' %>"
             <% if (kind) { %>data-mediakind="<%= kind %>" data-src="<%= url %>"<% } %>>
            <div class="card-thumb">
              <% if (kind === 'image') { %>
                <img src="<%= url %>" alt="" decoding="async" />
              <% } else if (kind === 'video') { %>
                <video data-lazy-src="<%= url %>" preload="metadata" muted playsinline disablepictureinpicture></video>
                <span class="video-marker" aria-hidden="true"></span>
              <% } else { %>
                <img class="icon-img" src="/public/icons/<%= fileIcon(f.mime_type, f.name) %>" alt="" />
              <% } %>
            </div>
            <div class="card-body">
              <div class="card-name"><%= f.name %></div>
              <div class="card-meta"><%= formatSize(f.size) %></div>
            </div>
          </a>
        <% }) %>
      </div>
    <% } %>
  </main>

  <!-- lightbox -->
  <div class="lightbox" id="lightbox" aria-hidden="true" role="dialog">
    <div class="lb-bar">
      <span class="lb-title" id="lb-title"></span>
      <a id="lb-download" href="#" download title="Download" aria-label="Download">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
          <polyline points="7 10 12 15 17 10" />
          <line x1="12" y1="15" x2="12" y2="3" />
        </svg>
      </a>
      <button type="button" id="lb-close" title="Close" aria-label="Close">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18" />
          <line x1="6" y1="6" x2="18" y2="18" />
        </svg>
      </button>
    </div>
    <div class="lb-stage">
      <button type="button" class="lb-nav lb-prev" id="lb-prev" aria-label="Previous">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="15 18 9 12 15 6" />
        </svg>
      </button>
      <div id="lb-content"></div>
      <button type="button" class="lb-nav lb-next" id="lb-next" aria-label="Next">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="9 18 15 12 9 6" />
        </svg>
      </button>
    </div>
  </div>

  <script src="/public/js/folder.js?v=<%= assetVersion %>"></script>
</body>
</html>
