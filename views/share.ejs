<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>
    <% if (state === 'file' || state === 'folder') { %>
      <%= itemName %>
    <% } else if (state === 'password') { %>
      <%= t('page.title.password') %>
    <% } else if (state === 'expired') { %>
      <%= t('page.title.expired') %>
    <% } else { %>
      <%= t('page.title.error') %>
    <% } %>
  </title>
  <meta name="robots" content="noindex,nofollow" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700&display=swap"
    rel="stylesheet"
  />
  <link rel="stylesheet" href="/public/css/share.css?v=<%= assetVersion %>" />
</head>
<body>
  <main>
    <section class="card">

      <% if (state === 'file') { %>
        <div class="icon-tile" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
            <polyline points="14 2 14 8 20 8" />
          </svg>
        </div>
        <h1><%= itemName %></h1>
        <p class="meta"><%= t('file.meta') %></p>
        <a class="btn" href="/share/<%= encodeURIComponent(token) %>/download" download>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
            <polyline points="7 10 12 15 17 10" />
            <line x1="12" y1="15" x2="12" y2="3" />
          </svg>
          <span><%= t('file.button') %></span>
        </a>

      <% } else if (state === 'password') { %>
        <div class="icon-tile" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2" />
            <path d="M7 11V7a5 5 0 0 1 10 0v4" />
          </svg>
        </div>
        <h1><%= t('password.heading') %></h1>
        <p class="lead"><%= t('password.lead') %></p>
        <form method="post" action="/share/<%= encodeURIComponent(token) %>/auth" autocomplete="off" novalidate>
          <div>
            <label for="password"><%= t('password.label') %></label>
            <div class="input-wrap">
              <input
                type="password"
                id="password"
                name="password"
                required
                autofocus
                autocapitalize="off"
                autocorrect="off"
                spellcheck="false"
              />
              <button
                type="button"
                class="toggle-pw"
                data-toggle="password"
                data-shown="false"
                data-label-show="<%= t('password.show') %>"
                data-label-hide="<%= t('password.hide') %>"
                aria-label="<%= t('password.show') %>"
              >
                <svg class="eye-on" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
                  <circle cx="12" cy="12" r="3" />
                </svg>
                <svg class="eye-off" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M17.94 17.94A10.94 10.94 0 0 1 12 20c-7 0-11-8-11-8a19.77 19.77 0 0 1 4.22-5.94" />
                  <path d="M9.9 4.24A10.94 10.94 0 0 1 12 4c7 0 11 8 11 8a19.6 19.6 0 0 1-3.17 4.19" />
                  <path d="M14.12 14.12a3 3 0 1 1-4.24-4.24" />
                  <line x1="1" y1="1" x2="23" y2="23" />
                </svg>
              </button>
            </div>
          </div>
          <% if (typeof error === 'string' && error) { %>
            <div class="error" role="alert">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10" />
                <line x1="12" y1="8" x2="12" y2="12" />
                <line x1="12" y1="16" x2="12.01" y2="16" />
              </svg>
              <span><%= error %></span>
            </div>
          <% } %>
          <button type="submit" class="btn"><%= t('password.button') %></button>
        </form>

      <% } else if (state === 'expired') { %>
        <div class="icon-tile" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10" />
            <polyline points="12 6 12 12 16 14" />
          </svg>
        </div>
        <h1><%= t('expired.heading') %></h1>
        <p class="lead tight"><%= t('expired.body') %></p>

      <% } else { %>
        <div class="icon-tile" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z" />
            <line x1="12" y1="9" x2="12" y2="13" />
            <line x1="12" y1="17" x2="12.01" y2="17" />
          </svg>
        </div>
        <h1><%= t('error.heading') %></h1>
        <p class="lead tight"><%= t('error.body') %></p>
      <% } %>

    </section>
  </main>

  <script src="/public/js/share.js?v=<%= assetVersion %>"></script>
</body>
</html>
