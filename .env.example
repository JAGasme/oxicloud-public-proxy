# Copy this file to `.env` and edit to suit your deployment.

# Required: OxiCloud reachable from the proxy.
# Use the Docker service name on a shared network, or a LAN host:port.
OXICLOUD_INTERNAL_URL=http://oxicloud:8086

# Required: public-facing URL the proxy is served from.
PUBLIC_BASE_URL=https://files.example.com

# Optional: TCP port (default 3000). Used for both the host port mapping
# and the in-container listen port - they must match.
# PORT=3000

# Optional: bind address (default 0.0.0.0).
# HOST=0.0.0.0

# Optional: pino log level (fatal, error, warn, info, debug, trace).
# LOG_LEVEL=info

# Optional: Strict-Transport-Security max-age in seconds (default one year),
# sent only on HTTPS requests. 0 disables it.
# HSTS_MAX_AGE=31536000

# Optional: who may set X-Forwarded-For/-Proto/-Host. Default: loopback,
# link-local and private ranges (a reverse proxy on this host, a Docker
# network, a LAN or VPN). Comma-separated IPs/CIDRs; "true" trusts anyone.
# TRUST_PROXY=loopback,linklocal,uniquelocal

# Optional: header your CDN/front proxy sets to the visitor's IP.
# CLIENT_IP_HEADER=cf-connecting-ip

# Optional: password-check rate limits (see README, "Client IPs and rate limits").
# AUTH_RATE_LIMIT_PER_IP=5
# AUTH_RATE_LIMIT_PER_TOKEN=10
# AUTH_RATE_LIMIT_WINDOW_SECS=60
# Keep below OxiCloud's OXICLOUD_RATE_LIMIT_LOGIN_MAX (default 10) and match
# its OXICLOUD_RATE_LIMIT_LOGIN_WINDOW_SECS.
# UPSTREAM_VERIFY_MAX=8
# UPSTREAM_VERIFY_WINDOW_SECS=60
# Send the visitor's IP to OxiCloud; needs OXICLOUD_TRUST_PROXY_CIDR there.
# UPSTREAM_FORWARD_CLIENT_IP=false
